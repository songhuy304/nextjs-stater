{
  "name": "reflows-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:user": "turbo run dev --filter=@repo/user",
    "build": "turbo run build",
    "build:user": "turbo run build --filter=@repo/user",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "turbo": "^2.5.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.14"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  }
}
